@page
@model IndexModel
@{
    ViewData["Title"] = "AI Security Human Motion & Suspicious Activity Hub";
}

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card bg-dark border-0 shadow-lg text-light">
            <div class="card-header bg-gradient-dark d-flex justify-content-between align-items-center border-bottom border-secondary">
                <h5 class="mb-0 text-info fw-bold">Live Security Monitoring Map</h5>
                <span class="badge bg-danger animate-pulse" id="status-badge">Live System Feed</span>
            </div>
            <div class="card-body p-0">
                <div id="map" style="height: 520px; border-radius: 0 0 12px 12px; filter: invert(0.9) hue-rotate(180deg);"></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-dark border-0 shadow-lg text-light h-100">
            <div class="card-header bg-gradient-dark border-bottom border-secondary">
                <h5 class="mb-0 text-warning fw-bold">System Statistics</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                        <span class="text-secondary">Total Active Cameras:</span>
                        <span class="fw-bold text-info">36</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                        <span class="text-secondary">Suspicious Threats:</span>
                        <span class="text-danger fw-bold" id="threat-count">0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                        <span class="text-secondary">Incidents Resolved:</span>
                        <span class="text-success fw-bold">24</span>
                    </div>
                    
                    <hr class="border-secondary">
                    <h6 class="text-info fw-bold mb-3">Threat Distribution</h6>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-secondary">Intruding</small>
                            <small class="text-danger">60%</small>
                        </div>
                        <div class="progress bg-secondary" style="height: 6px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: 60%" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-secondary">Loitering</small>
                            <small class="text-warning">30%</small>
                        </div>
                        <div class="progress bg-secondary" style="height: 6px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 30%" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card bg-dark border-0 shadow-lg text-light">
            <div class="card-header bg-gradient-dark border-bottom border-secondary py-3">
                <h5 class="mb-0 text-success fw-bold">Surveillance Alerts Feed</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 border-secondary">
                        <thead>
                            <tr class="text-info">
                                <th>ID</th>
                                <th>Camera ID</th>
                                <th>Behavior / Threat</th>
                                <th>Confidence</th>
                                <th>Detection Time</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="detection-rows">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Connecting to surveillance database stream...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}
