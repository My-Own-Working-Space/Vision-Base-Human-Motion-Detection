FROM python:3.12-slim

# Install system dependencies required for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first
COPY requirements.txt .

# Install PyTorch CPU first to avoid downloading ~3GB of CUDA dependencies (reduces size to ~200MB)
RUN pip install --no-cache-dir torch==2.12.0 torchvision==0.27.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu

# Copy source code and models
COPY edge/ /app/edge/
COPY inference/ /app/inference/
COPY models/ /app/models/

# Create alerts directory inside container
RUN mkdir -p /app/alerts

# Expose edge server port (default 8001)
EXPOSE 8001

# Run the edge service main script
CMD ["python", "edge/main.py"]
