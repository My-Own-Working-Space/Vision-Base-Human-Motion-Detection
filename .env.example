# ── Edge Device Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials/settings.

# ── Camera ────────────────────────────────────────────────────────────────────
IP_CAMERA_URL=0                      # 0 = webcam, or RTSP URL / video file path
TARGET_FPS=8                         # Target processing FPS
MAX_FRAME_WIDTH=640                  # Max frame width for resize

# ── Detection Pipeline ────────────────────────────────────────────────────────
DEVICE_MODE=server                   # "embedded" (Jetson/RPi) or "server" (desktop/cloud)
LSTM_MODEL_PATH=models/mobilenetv3_ucf_crime.pt        # Override LSTM model path
# YOLO_MODEL_PATH=                   # Override YOLO model path
SEQUENCE_LENGTH=16                   # LSTM sliding window length
LSTM_TRAIN_FPS=30                    # FPS the LSTM was trained at
BLUR_THRESHOLD=30.0                  # Laplacian variance threshold for blur detection

# ── State Machine ─────────────────────────────────────────────────────────────
PROCESSING_DURATION=2.0              # AI active burst duration (seconds)
SLEEP_DURATION=3.0                   # Watchdog-only rest period (seconds)
MOTION_THRESHOLD=5000                # Base pixel diff threshold for motion detection
ADAPTIVE_ALPHA=1.2                   # Adaptive threshold multiplier
# ADAPTIVE_BETA=                     # Defaults to MOTION_THRESHOLD
GRACE_PERIOD=30                      # Frames before deleting a lost track

# ── Alert System ──────────────────────────────────────────────────────────────
ALERT_CONFIDENCE_THRESHOLD=0.70      # Minimum confidence to trigger alert
ALERTS_DIRECTORY=alerts              # Directory for alert images and CSV
LATITUDE=10.7769                     # Camera/device latitude
LONGITUDE=106.7009                   # Camera/device longitude

# ── Backend API ───────────────────────────────────────────────────────────────
DASHBOARD_API_URL=http://localhost:8000  # Default to own edge server for easy localhost testing
DETECTIONS_ENDPOINT=/api/detections     # Detections API endpoint
API_TIMEOUT_SECONDS=5                   # HTTP request timeout
API_MAX_RETRIES=3                       # Max retry attempts for failed uploads
API_RETRY_DELAY_SECONDS=5.0            # Delay between retry attempts

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
