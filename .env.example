# ── Edge Device Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials/settings.

# ── Camera ────────────────────────────────────────────────────────────────────
# Camera options:
# - Webcam: 0
# - IP Camera: http://11.108.13.124:8081/video
IP_CAMERA_URL=http://11.108.13.124:8081/video
TARGET_FPS=8                         # Target processing FPS
MAX_FRAME_WIDTH=640                  # Max frame width for resize

# ── Detection Pipeline ────────────────────────────────────────────────────────
DEVICE_MODE=server                   # "embedded" (Jetson/RPi) or "server" (desktop/cloud)
# LSTM_MODEL_PATH=                   # Override LSTM model path
# YOLO_MODEL_PATH=                   # Override YOLO model path
SEQUENCE_LENGTH=16                   # LSTM sliding window length
LSTM_TRAIN_FPS=30                    # FPS the LSTM was trained at
BLUR_THRESHOLD=30.0                  # Laplacian variance threshold for blur detection

# ── State Machine ─────────────────────────────────────────────────────────────
PROCESSING_DURATION=2.0              # AI active burst duration (seconds)
SLEEP_DURATION=3.0                   # Watchdog-only rest period (seconds)
MOTION_THRESHOLD=5000                # Base pixel diff threshold for motion detection
ADAPTIVE_ALPHA=1.2                   # Adaptive threshold multiplier
# ADAPTIVE_BETA=                     # Defaults to MOTION_THRESHOLD
GRACE_PERIOD=30                      # Frames before deleting a lost track

# ── Alert System ──────────────────────────────────────────────────────────────
ALERT_CONFIDENCE_THRESHOLD=0.70      # Minimum confidence to trigger alert
ALERTS_DIRECTORY=alerts              # Directory for alert images and CSV
LATITUDE=10.7769                     # Camera/device latitude
LONGITUDE=106.7009                   # Camera/device longitude

# ── Backend API ───────────────────────────────────────────────────────────────
DASHBOARD_API_ENABLED=false
DASHBOARD_API_URL=http://localhost:8000  # Default to own edge server for easy localhost testing
DETECTIONS_ENDPOINT=/api/detections     # Detections API endpoint
API_TIMEOUT_SECONDS=5                   # HTTP request timeout
API_MAX_RETRIES=3                       # Max retry attempts for failed uploads
API_RETRY_DELAY_SECONDS=5.0            # Delay between retry attempts

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── PMS Bridge (UavPms .NET Backend Integration) ─────────────────────────────
# Enable to forward detections to the UavPms .NET backend alongside mock backend
PMS_BRIDGE_ENABLED=false                      # true = enable forwarding to PMS

# PMS Backend URL Options:
# - Local (Testing): http://localhost:5196
# - Remote (Production): https://uavpms.ddns.net (Swagger: https://uavpms.ddns.net/swagger/index.html)
PMS_BRIDGE_URL=http://localhost:5196
# PMS_BRIDGE_URL=https://uavpms.ddns.net

PMS_BRIDGE_ENDPOINT=/api/v1/vision/detections  # PMS detection endpoint
PMS_BRIDGE_TIMEOUT=5                           # HTTP timeout (seconds)
PMS_BRIDGE_SERIAL=RPI-123456
PMS_BRIDGE_SOFTWARE_VERSION=1.0.0

# ── Roboflow Workflow: EVN Object Detection ──────────────────────────────────
ROBOFLOW_WORKFLOW_ENABLED=false
ROBOFLOW_API_KEY=                              # Set in .env only; never commit secrets
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_WORKSPACE_NAME=les-workspace-ijdwd
ROBOFLOW_WORKFLOW_ID=evn-object-detection-vevn-object-detection-cnyo0-1-rfdetr-small-t1-logic
ROBOFLOW_IMAGE_INPUT_NAME=image
ROBOFLOW_EXPECTED_OUTPUT_KEYS=predictions
ROBOFLOW_TIMEOUT_SECONDS=20
ROBOFLOW_MAX_RETRIES=2
ROBOFLOW_RETRY_BACKOFF_SECONDS=1.0
ROBOFLOW_IMAGE_OUTPUT_DIRECTORY=roboflow_outputs
